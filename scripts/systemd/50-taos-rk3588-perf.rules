// taOS - Settings performance-mode toggle for taos-rk3588-perf.service (#361).
//
// The controller runs as the unprivileged `taos` user, and the Settings
// PUT /api/settings/rk3588-performance handler flips performance mode
// with `systemctl start|stop taos-rk3588-perf.service`. Under systemd's
// default polkit policy that requires an interactive admin auth the
// controller cannot give, so install-server.sh installs this rule next
// to the unit: exactly this one unit, exactly the one systemd1 action
// the toggle needs, exactly the controller user. Nothing else.
//
// The toggle deliberately never enables/disables the unit. systemd
// attaches the unit name (and the verb) as details to manage-units
// requests, so the unit scope below is real; but it attaches NO
// details to the unit-files action's requests - in systemd's
// bus_verify_manage_unit_files_async the details are NULL (checked
// against v257; bookworm's systemd 252 is built the same way) - so
// action.lookup("unit") can never match there, and no rule can scope
// that action to one unit. The only alternative grant would be
// unit-files control over EVERY unit for the controller user, which
// this rule does not give. Instead the unit stays enabled and the
// toggle's persisted on/off choice is a flag file the unit gates its
// boot start on (ConditionPathExists in the unit file); start/stop
// covers the immediate effect.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "taos-rk3588-perf.service" &&
        subject.user == "taos") {
        return polkit.Result.YES;
    }
});
