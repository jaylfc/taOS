# taos-rk3588-perf.service — Rockchip RK3588 Performance Mode
#
# Applies SoC-level performance tuning on boot so the RK3588 NPU runs at
# full throughput without manual intervention after every power cycle.
# Without this, rkllama degrades to ~20% of rated tok/s because the
# kernel defaults all devfreq governors to 'simple_ondemand' (#361).
#
# The governor work itself lives in the taos-rk3588-perf helper script
# (scripts/taos-rk3588-perf.sh, installed to /usr/local/bin): devfreq
# domains expose `governor` while cpufreq policy dirs expose
# `scaling_governor`, and stop must restore the exact governor start
# recorded for each domain — the split is per-family in the helper and
# covered by tests/test_rk3588_perf_service.sh against a fake sysfs.
#
# Scope: RK3588 / RK3576 / RK3568 only. The ConditionPathExists check
# gates this to boards with an NPU devfreq entry; the helper does a
# second-level device-tree check to avoid false positives on RK3588
# boards running kernels without the NPU driver loaded. The service is
# a silent no-op on x86, Raspberry Pi, and other non-Rockchip hardware.
#
# Install (done automatically by install-server.sh):
#     sudo cp scripts/systemd/taos-rk3588-perf.service /etc/systemd/system/
#     sudo install -m 0755 scripts/taos-rk3588-perf.sh /usr/local/bin/taos-rk3588-perf
#     sudo install -d -o taos -g taos /var/lib/taos-rk3588-perf
#     sudo install -o taos -g taos -m 0644 /dev/null /var/lib/taos-rk3588-perf/enabled
#     sudo systemctl daemon-reload
#     sudo systemctl enable taos-rk3588-perf.service
#
# The Settings toggle does NOT enable/disable this unit: systemd's
# unit-files polkit action carries no unit detail a rule could scope
# by, so the unprivileged controller user cannot be granted
# enable/disable for just this unit (see the polkit rule file). The
# unit stays enabled; the toggle persists its choice in the flag file
# above - this unit's boot start gates on it via ConditionPathExists -
# and starts/stops the unit for the immediate effect. Off by hand:
#     sudo rm /var/lib/taos-rk3588-perf/enabled
#     sudo systemctl stop taos-rk3588-perf.service
[Unit]
Description=Rockchip RK3588 performance mode — devfreq governors + NPU tuning
Documentation=https://github.com/jaylfc/tinyagentos/issues/361
# Gate: only activate on boards that expose an NPU devfreq entry.
ConditionPathExists=/sys/class/devfreq
# Gate: the Settings performance toggle's persisted on/off flag.
ConditionPathExists=/var/lib/taos-rk3588-perf/enabled

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/taos-rk3588-perf start
ExecStop=/usr/local/bin/taos-rk3588-perf stop

[Install]
WantedBy=multi-user.target
