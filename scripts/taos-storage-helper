#!/usr/bin/env python3
"""taOS Storage Helper: privileged operations for storage engine.

This script runs via passwordless sudo from the taOS controller.
Allowed commands are strictly allowlisted to prevent arbitrary command execution.

Commands:
  partition-disk <by-id-path> <confirm>  - Create GPT with single partition on disk (re-validates disk)
  luks-format <part-path> <name> <key>   - Format partition as LUKS2 with key file
  luks-open <part-path> <name> <key>     - Open LUKS device
  luks-close <name>                      - Close LUKS device
  make-fs <device> <label>               - Create ext4 filesystem with label
  mount-fs <mountpoint>                  - Mount filesystem at mountpoint
  unmount-fs <mountpoint>                - Unmount filesystem
  write-crypttab <name> <dev> <key>      - Write /etc/crypttab entry
  write-mount-unit <name> <dev> <mp> <encrypted> - Write systemd mount unit
  remove-mount-unit <name>               - Remove systemd mount unit
  get-mount-info <mountpoint>            - Get mount info
"""
from __future__ import annotations

import argparse
import json
import logging
import os
import re
import secrets
import subprocess
import sys
from dataclasses import dataclass, field
from pathlib import Path
from typing import Literal

logging.basicConfig(
    level=logging.INFO,
    format="[taos-storage-helper] %(levelname)s %(message)s",
)
logger = logging.getLogger(__name__)

ALLOWED_COMMANDS = {
    "partition-disk",
    "luks-format",
    "luks-open",
    "luks-close",
    "make-fs",
    "mount-fs",
    "unmount-fs",
    "write-crypttab",
    "write-mount-unit",
    "remove-mount-unit",
    "get-mount-info",
}

# Safety classification constants (must match storage_engine.py)
SAFETY_AVAILABLE = "available"
SAFETY_PROTECTED = "protected"
PROTECTED_SYSTEM_DISK = "system-disk"
PROTECTED_MOUNTED = "mounted"
PROTECTED_READ_ONLY = "read-only"
PROTECTED_HAS_DATA = "has-data"
PROTECTED_ENCRYPTED_FOREIGN = "encrypted-foreign"
PROTECTED_RAID_MEMBER = "raid-member"
PROTECTED_LVM_MEMBER = "lvm-member"
PROTECTED_ZFS_MEMBER = "zfs-member"
PROTECTED_UNKNOWN = "unknown"

DATA_FS_TYPES = frozenset({
    "ext2", "ext3", "ext4", "xfs", "btrfs", "zfs", "jfs", "reiserfs",
    "vfat", "ntfs", "exfat", "f2fs", "hfs", "hfs+", "apfs",
    "iso9660", "udf", "squashfs", "erofs",
})
ENCRYPTED_TYPES = frozenset({"crypto_LUKS", "crypto_LUKS1", "crypto_LUKS2", "BitLocker"})


@dataclass
class PartitionInfo:
    path: str
    name: str
    size_bytes: int
    fstype: str | None = None
    uuid: str | None = None
    label: str | None = None
    mountpoint: str | None = None
    parttype: str | None = None
    partlabel: str | None = None


@dataclass
class DiskInfo:
    path: str
    name: str
    make: str
    model: str
    serial: str
    size_bytes: int
    transport: str
    rotational: bool
    partitions: list[PartitionInfo] = field(default_factory=list)
    mountpoints: list[str] = field(default_factory=list)
    fstype: str | None = None
    uuid: str | None = None
    label: str | None = None
    parttable_type: str | None = None
    ro: bool = False


def run_cmd(cmd: list[str], check: bool = True, capture: bool = True, input_data: bytes | str | None = None) -> subprocess.CompletedProcess:
    """Run a command and return result."""
    logger.info("Running: %s", " ".join(cmd))
    use_text = input_data is None or isinstance(input_data, str)
    result = subprocess.run(cmd, capture_output=capture, text=use_text, input=input_data)
    if result.stdout:
        logger.debug("stdout: %s", result.stdout.strip())
    if result.stderr:
        logger.debug("stderr: %s", result.stderr.strip())
    if check and result.returncode != 0:
        raise subprocess.CalledProcessError(result.returncode, cmd, result.stdout, result.stderr)
    return result


def _parse_size(size_str: str) -> int:
    """Parse lsblk size string (e.g., '1.8T', '500G', '100M') to bytes."""
    size_str = size_str.strip().upper()
    if not size_str or size_str == "0":
        return 0
    multipliers = {
        "K": 1024, "M": 1024**2, "G": 1024**3, "T": 1024**4, "P": 1024**5, "E": 1024**6,
        "KI": 1024, "MI": 1024**2, "GI": 1024**3, "TI": 1024**4, "PI": 1024**5, "EI": 1024**6,
    }
    for suffix, mult in multipliers.items():
        if size_str.endswith(suffix):
            try:
                return int(float(size_str[:-len(suffix)]) * mult)
            except ValueError:
                return 0
    try:
        return int(float(size_str))
    except ValueError:
        return 0


def discover_disk(disk_by_id_path: str) -> DiskInfo | None:
    """Discover a single disk by its by-id path and classify it.
    
    Returns DiskInfo with safety classification, or None if not found.
    """
    # Resolve by-id path to real device
    try:
        real_path = os.path.realpath(disk_by_id_path)
    except OSError:
        logger.error("Failed to resolve path: %s", disk_by_id_path)
        return None
    
    # Get device name (e.g., sda from /dev/sda)
    device_name = os.path.basename(real_path)
    if device_name.startswith("dm-") or device_name.startswith("loop"):
        logger.error("Device %s is a virtual device, refusing", device_name)
        return None
    
    # Run lsblk for this disk and its children
    rc, out = run_cmd([
        "lsblk", "-J", "-o",
        "NAME,SIZE,ROTA,TRAN,RO,MODEL,VENDOR,SERIAL,TYPE,MOUNTPOINTS,FSTYPE,UUID,LABEL,PARTTYPE,PARTLABEL,PTTYPE",
        real_path
    ], check=False)
    if rc != 0:
        logger.error("lsblk failed for %s: %s", real_path, out)
        return None
    
    try:
        data = json.loads(out)
    except json.JSONDecodeError:
        logger.error("Failed to parse lsblk JSON: %s", out[:200])
        return None
    
    blockdevices = data.get("blockdevices", [])
    if not blockdevices:
        logger.error("No block device found for %s", real_path)
        return None
    
    block = blockdevices[0]
    if block.get("type") != "disk":
        logger.error("Path %s is not a disk (type=%s)", real_path, block.get("type"))
        return None
    
    name = block.get("name", "")
    if not name:
        logger.error("Disk has no name")
        return None
    
    # Parse disk metadata
    size_str = block.get("size", "0")
    size_bytes = _parse_size(size_str)
    rota = block.get("rota", "1")
    rotational = rota == "1"
    transport = block.get("tran", "unknown")
    ro_str = block.get("ro", "0")
    ro = ro_str == "1"
    vendor = (block.get("vendor") or "").strip()
    model = (block.get("model") or "").strip()
    serial = (block.get("serial") or "").strip()
    make = vendor or "Unknown"
    
    mountpoints = []
    mp = block.get("mountpoints")
    if mp:
        if isinstance(mp, list):
            mountpoints = [m for m in mp if m]
        elif isinstance(mp, str):
            mountpoints = [mp] if mp else []
    
    fstype = block.get("fstype")
    uuid = block.get("uuid")
    label = block.get("label")
    parttable = block.get("pttype")
    if parttable and parttable.lower() in ("gpt", "dos", "msdos"):
        parttable = parttable.lower()
    else:
        parttable = None
    
    # Get partitions
    partitions = []
    for part in block.get("children", []):
        part_name = part.get("name", "")
        if not part_name:
            continue
        part_size_str = part.get("size", "0")
        part_size = _parse_size(part_size_str)
        part_fstype = part.get("fstype")
        part_uuid = part.get("uuid")
        part_label = part.get("label")
        part_mount = part.get("mountpoints")
        part_mountpoint = None
        if part_mount:
            if isinstance(part_mount, list) and part_mount:
                part_mountpoint = part_mount[0]
            elif isinstance(part_mount, str):
                part_mountpoint = part_mount
        part_parttype = part.get("parttype")
        part_partlabel = part.get("partlabel")
        
        partitions.append(PartitionInfo(
            path=f"/dev/{part_name}",
            name=part_name,
            size_bytes=part_size,
            fstype=part_fstype,
            uuid=part_uuid,
            label=part_label,
            mountpoint=part_mountpoint,
            parttype=part_parttype,
            partlabel=part_partlabel,
        ))
    
    # Verify signatures with blkid and wipefs on disk and all partitions
    _verify_signatures(real_path)
    for part in partitions:
        _verify_signatures(part.path)
    
    disk = DiskInfo(
        path=real_path,
        name=name,
        make=make,
        model=model,
        serial=serial,
        size_bytes=size_bytes,
        transport=transport,
        rotational=rotational,
        partitions=partitions,
        mountpoints=mountpoints,
        fstype=fstype,
        uuid=uuid,
        label=label,
        parttable_type=parttable,
        ro=ro,
    )
    
    # Classify safety (no system disk check in helper - controller handles that)
    return _classify_disk(disk)


def _verify_signatures(device_path: str) -> None:
    """Run blkid -p and wipefs -n to verify signatures. Log discrepancies."""
    # Try blkid -p first
    rc, out = run_cmd(["blkid", "-p", device_path], check=False)
    if rc == 0 and out.strip():
        for line in out.strip().splitlines():
            if "TYPE=" in line:
                match = re.search(r'TYPE="([^"]+)"', line)
                if match:
                    logger.debug("blkid signature on %s: %s", device_path, match.group(1))
                    return
    
    # Fallback to wipefs -n
    rc, out = run_cmd(["wipefs", "-n", device_path], check=False)
    if rc == 0 and out.strip():
        lines = out.strip().splitlines()
        if len(lines) > 1:
            for line in lines[1:]:
                parts = line.split()
                if len(parts) >= 2:
                    logger.debug("wipefs signature on %s: %s", device_path, parts[1])
                    return


def _has_data_fs(disk: DiskInfo) -> bool:
    if disk.fstype and disk.fstype in DATA_FS_TYPES:
        return True
    for part in disk.partitions:
        if part.fstype and part.fstype in DATA_FS_TYPES:
            return True
    return False


def _is_encrypted_foreign(disk: DiskInfo) -> bool:
    if disk.fstype and disk.fstype in ENCRYPTED_TYPES:
        return True
    for part in disk.partitions:
        if part.fstype and part.fstype in ENCRYPTED_TYPES:
            return True
    return False


def _is_raid_member(disk: DiskInfo) -> bool:
    if disk.fstype == "linux_raid_member":
        return True
    for part in disk.partitions:
        if part.fstype == "linux_raid_member":
            return True
    return False


def _is_lvm_member(disk: DiskInfo) -> bool:
    if disk.fstype == "LVM2_member":
        return True
    for part in disk.partitions:
        if part.fstype == "LVM2_member":
            return True
    return False


def _is_zfs_member(disk: DiskInfo) -> bool:
    if disk.fstype and disk.fstype.startswith("zfs_"):
        return True
    for part in disk.partitions:
        if part.fstype and part.fstype.startswith("zfs_"):
            return True
    return False


def _classify_disk(disk: DiskInfo) -> DiskInfo:
    """Classify disk safety (without system disk check)."""
    reasons: list[str] = []
    
    if disk.ro:
        reasons.append(PROTECTED_READ_ONLY)
    
    if disk.mountpoints:
        reasons.append(PROTECTED_MOUNTED)
    for part in disk.partitions:
        if part.mountpoint:
            reasons.append(PROTECTED_MOUNTED)
            break
    
    if _has_data_fs(disk):
        reasons.append(PROTECTED_HAS_DATA)
    
    if _is_encrypted_foreign(disk):
        reasons.append(PROTECTED_ENCRYPTED_FOREIGN)
    
    if _is_raid_member(disk):
        reasons.append(PROTECTED_RAID_MEMBER)
    
    if _is_lvm_member(disk):
        reasons.append(PROTECTED_LVM_MEMBER)
    
    if _is_zfs_member(disk):
        reasons.append(PROTECTED_ZFS_MEMBER)
    
    if reasons:
        disk.safety_class = SAFETY_PROTECTED
        disk.safety_reason = ",".join(reasons)
    else:
        disk.safety_class = SAFETY_AVAILABLE
        disk.safety_reason = None
    
    return disk


def cmd_partition_disk(disk_by_id_path: str, confirm: str) -> int:
    """Create GPT partition table with single partition covering whole disk.
    
    Re-validates disk safety and confirm string before any write.
    """
    # Re-validate disk
    disk = discover_disk(disk_by_id_path)
    if not disk:
        logger.error("Disk not found or invalid: %s", disk_by_id_path)
        return 1
    
    # Verify confirm string matches exactly: "<model> <serial>"
    expected_confirm = f"{disk.model} {disk.serial}".strip()
    if confirm != expected_confirm:
        logger.error("Confirm string mismatch. Expected: %s, Got: %s", expected_confirm, confirm)
        return 1
    
    # Refuse unless available
    if disk.safety_class != SAFETY_AVAILABLE:
        logger.error("Disk is not available: %s", disk.safety_reason)
        return 1
    
    logger.info("Disk validated as available: %s (%s)", disk_by_id_path, disk.serial)
    
    # Wipe any existing partition table (with check=True now!)
    run_cmd(["wipefs", "-a", disk.path], check=True)
    
    # Create GPT with single partition
    run_cmd(["parted", "-s", disk.path, "mklabel", "gpt"])
    run_cmd(["parted", "-s", disk.path, "mkpart", "primary", "0%", "100%"])
    run_cmd(["parted", "-s", disk.path, "set", "1", "legacy_boot", "on"])
    
    # Trigger udev to create partition symlinks
    run_cmd(["udevadm", "settle"], check=False)
    run_cmd(["partprobe", disk.path], check=False)
    run_cmd(["udevadm", "settle"], check=False)
    
    return 0


def cmd_luks_format(part_path: str, name: str, key_file: str) -> int:
    """Format partition as LUKS2 with random key file."""
    # Generate random key
    key = secrets.token_bytes(64)

    # Write key file (root-only, 0400) using os.open with O_CREAT|O_EXCL
    key_dir = Path(key_file).parent
    key_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
    fd = os.open(key_file, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o400)
    try:
        os.write(fd, key)
    finally:
        os.close(fd)

    # Format LUKS2 with key file
    run_cmd([
        "cryptsetup", "luksFormat", "--type", "luks2",
        "--key-file", "-", part_path
    ], capture=False, check=True, input_data=key)

    logger.info("LUKS2 formatted: %s", part_path)
    return 0


def cmd_luks_open(part_path: str, name: str, key_file: str) -> int:
    """Open LUKS device using key file."""
    run_cmd([
        "cryptsetup", "open", "--key-file", key_file,
        part_path, name
    ], capture=False)
    logger.info("LUKS opened: %s -> /dev/mapper/%s", part_path, name)
    return 0


def cmd_luks_close(name: str) -> int:
    """Close LUKS device."""
    run_cmd(["cryptsetup", "close", name], capture=False, check=False)
    logger.info("LUKS closed: %s", name)
    return 0


def cmd_make_fs(device: str, label: str) -> int:
    """Create ext4 filesystem with label."""
    run_cmd(["mkfs.ext4", "-F", "-L", label, device], capture=False)
    logger.info("ext4 created on %s with label %s", device, label)
    return 0


def cmd_mount_fs(mountpoint: str) -> int:
    """Mount filesystem at mountpoint."""
    Path(mountpoint).mkdir(parents=True, exist_ok=True)
    run_cmd(["mount", mountpoint], capture=False)
    logger.info("Mounted: %s", mountpoint)
    return 0


def cmd_unmount_fs(mountpoint: str) -> int:
    """Unmount filesystem."""
    run_cmd(["umount", mountpoint], capture=False, check=False)
    logger.info("Unmounted: %s", mountpoint)
    return 0


def cmd_write_crypttab(name: str, device: str, key_file: str) -> int:
    """Write /etc/crypttab entry with key file and nofail."""
    # Resolve device to stable by-id path
    device_real = os.path.realpath(device)
    by_id = None
    by_id_dir = Path("/dev/disk/by-id")
    if by_id_dir.exists():
        for link in by_id_dir.iterdir():
            try:
                if os.path.realpath(link) == device_real:
                    by_id = str(link)
                    break
            except OSError:
                continue

    use_device = by_id or device_real

    entry = f"{name} {use_device} {key_file} luks,nofail\n"
    crypttab = Path("/etc/crypttab")
    content = crypttab.read_text() if crypttab.exists() else ""

    # Remove any existing entry for this name
    lines = [l for l in content.splitlines() if not l.strip().startswith(f"{name} ")]
    lines.append(entry.strip())
    crypttab.write_text("\n".join(lines) + "\n")
    logger.info("Updated /etc/crypttab for %s", name)
    return 0


def cmd_write_mount_unit(name: str, device: str, mountpoint: str, encrypted: bool) -> int:
    """Write systemd mount unit with nofail."""
    # Resolve device to stable by-id or /dev/mapper path
    if encrypted:
        use_device = f"/dev/mapper/{name}"
    else:
        device_real = os.path.realpath(device)
        by_id = None
        by_id_dir = Path("/dev/disk/by-id")
        if by_id_dir.exists():
            for link in by_id_dir.iterdir():
                try:
                    if os.path.realpath(link) == device_real:
                        by_id = str(link)
                        break
                except OSError:
                    pass
        use_device = by_id or device_real

    unit_name = f"srv-taos-storage-{name.replace('-', '\\x2d')}.mount"
    unit_path = Path(f"/etc/systemd/system/{unit_name}")

    # Build unit content conditionally
    if encrypted:
        content = f"""[Unit]
Description=taOS storage area {name}
After=systemd-udev-settle.service
Requires=systemd-cryptsetup@{name}.service
After=systemd-cryptsetup@{name}.service

[Mount]
What={use_device}
Where={mountpoint}
Type=ext4
Options=defaults,nofail,x-systemd.requires=systemd-cryptsetup@{name}.service

[Install]
WantedBy=multi-user.target
"""
    else:
        content = f"""[Unit]
Description=taOS storage area {name}
After=systemd-udev-settle.service

[Mount]
What={use_device}
Where={mountpoint}
Type=ext4
Options=defaults,nofail

[Install]
WantedBy=multi-user.target
"""

    unit_path.write_text(content)
    run_cmd(["systemctl", "daemon-reload"], check=False)
    run_cmd(["systemctl", "enable", unit_name], check=False)
    logger.info("Created mount unit: %s", unit_path)
    return 0


def cmd_remove_mount_unit(name: str) -> int:
    """Remove systemd mount unit."""
    unit_name = f"srv-taos-storage-{name.replace('-', '\\x2d')}.mount"
    unit_path = Path(f"/etc/systemd/system/{unit_name}")
    if unit_path.exists():
        run_cmd(["systemctl", "disable", unit_name], check=False)
        unit_path.unlink()
        run_cmd(["systemctl", "daemon-reload"], check=False)
        logger.info("Removed mount unit: %s", unit_name)
    return 0


def cmd_get_mount_info(mountpoint: str) -> int:
    """Get mount info as JSON."""
    result = run_cmd(["findmnt", "-J", "-o", "TARGET,SOURCE,FSTYPE,SIZE,AVAIL,USED", mountpoint])
    if result.returncode == 0:
        print(result.stdout)
    else:
        print(json.dumps({"error": "not mounted"}))
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description="taOS Storage Helper")
    parser.add_argument("command", choices=sorted(ALLOWED_COMMANDS))
    parser.add_argument("args", nargs=argparse.REMAINDER)
    args = parser.parse_args()

    if args.command not in ALLOWED_COMMANDS:
        logger.error("Command not allowed: %s", args.command)
        return 1

    try:
        if args.command == "partition-disk":
            if len(args.args) != 2:
                logger.error("partition-disk requires <disk-by-id-path> <confirm>")
                return 1
            return cmd_partition_disk(args.args[0], args.args[1])

        elif args.command == "luks-format":
            if len(args.args) != 3:
                logger.error("luks-format requires <part-path> <name> <key-file>")
                return 1
            return cmd_luks_format(args.args[0], args.args[1], args.args[2])

        elif args.command == "luks-open":
            if len(args.args) != 3:
                logger.error("luks-open requires <part-path> <name> <key-file>")
                return 1
            return cmd_luks_open(args.args[0], args.args[1], args.args[2])

        elif args.command == "luks-close":
            if len(args.args) != 1:
                logger.error("luks-close requires <name>")
                return 1
            return cmd_luks_close(args.args[0])

        elif args.command == "make-fs":
            if len(args.args) != 2:
                logger.error("make-fs requires <device> <label>")
                return 1
            return cmd_make_fs(args.args[0], args.args[1])

        elif args.command == "mount-fs":
            if len(args.args) != 1:
                logger.error("mount-fs requires <mountpoint>")
                return 1
            return cmd_mount_fs(args.args[0])

        elif args.command == "unmount-fs":
            if len(args.args) != 1:
                logger.error("unmount-fs requires <mountpoint>")
                return 1
            return cmd_unmount_fs(args.args[0])

        elif args.command == "write-crypttab":
            if len(args.args) != 3:
                logger.error("write-crypttab requires <name> <device> <key-file>")
                return 1
            return cmd_write_crypttab(args.args[0], args.args[1], args.args[2])

        elif args.command == "write-mount-unit":
            if len(args.args) != 4:
                logger.error("write-mount-unit requires <name> <device> <mountpoint> <encrypted>")
                return 1
            encrypted = args.args[3].lower() == "true"
            return cmd_write_mount_unit(args.args[0], args.args[1], args.args[2], encrypted)

        elif args.command == "remove-mount-unit":
            if len(args.args) != 1:
                logger.error("remove-mount-unit requires <name>")
                return 1
            return cmd_remove_mount_unit(args.args[0])

        elif args.command == "get-mount-info":
            if len(args.args) != 1:
                logger.error("get-mount-info requires <mountpoint>")
                return 1
            return cmd_get_mount_info(args.args[0])

    except subprocess.CalledProcessError as exc:
        logger.error("Command failed: %s", exc)
        if exc.stdout:
            logger.error("stdout: %s", exc.stdout)
        if exc.stderr:
            logger.error("stderr: %s", exc.stderr)
        return exc.returncode
    except Exception as exc:
        logger.exception("Unexpected error: %s", exc)
        return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())