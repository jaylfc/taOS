#!/usr/bin/env python3
"""Keep the lock screen fullscreen, and the signed-in desktop out of it.

Jay (2026-09-29): the nav bar is hidden on the lock screen and shown once
signed in ("a"). The bar is a layer-shell surface that reserves its strip; a
FULLSCREEN window covers it and ignores that strip. Both the lock screen and
the desktop are the same kiosk window (workspace 1), so its fullscreen state
is what shows or hides the bar there:

    title "Sign in ..."  (the lock screen)   -> fullscreen: bar covered
    anything else        (the desktop)       -> not fullscreen: bar shown,
                                                 page sized above it

Measured on the handset before writing this: chromium --kiosk accepted
`fullscreen disable` and did not re-request it.

THE BAR ITSELF IS STARTED HERE, not by sway at session start. Jay (2026-09-30):
the boot logo showed the nav bar. sway paints the boot wordmark as its
background for the ~16 s the server takes to start, and nothing fullscreen
covered a bar started with the session. So there is no bar until the first
surface that needs one (the signed-in desktop or a taOS app window); after
that it stays, and the lock screen covers it by being fullscreen as before.

A kiosk window whose title is still loading (empty, or the URL chromium shows
before the page sets one) is left alone entirely: it is neither the lock
screen nor the desktop yet, so it must not start the bar or have its
fullscreen state touched.

Event-driven (sway's window events), plus a scan at start so the state is
right after a restart. Runs in the session as taos (exec_always), so it has
SWAYSOCK; a reload replaces the previous copy by pid.
"""
import json
import os
import subprocess
import sys

KIOSK_APP_ID = "chrome-127.0.0.1__-Default"   # the kiosk's app_id, measured
# EXACT, not a prefix: a taOS app opened in the kiosk's profile is
# chrome-127.0.0.1__app.html-Default and must never be forced fullscreen.
LOCK_TITLE = "Sign in"


def swaymsg(*args):
    return subprocess.run(["swaymsg", *args], capture_output=True, text=True)


BAR = "/usr/local/bin/taos-kiosk-bar"


def wanted_fullscreen(title):
    return (title or "").startswith(LOCK_TITLE)


def loading(title):
    """The page has not set a title yet: chromium shows the URL, or nothing."""
    t = (title or "").strip().lower()
    return (not t or "://" in t or t.startswith("about:")
            or t.startswith("127.0.0.1") or t.startswith("localhost"))


def run_dir():
    return os.environ.get("XDG_RUNTIME_DIR") or "/run/user/%d" % os.getuid()


def bar_running():
    try:
        pid = int(open(os.path.join(run_dir(), "taos-kiosk-bar.pid")).read().strip())
        return open("/proc/%d/comm" % pid).read().strip() == "waybar"
    except (OSError, ValueError):
        return False


def start_bar(replace=False):
    """Start the nav bar unless it is up. replace=True restarts it (a reload)."""
    if replace or not bar_running():
        subprocess.run([BAR])


#: taOS apps opened in the kiosk's profile (taos-shelld /launch). The kiosk's
#: chromium runs --kiosk, and a window it opens inherits that and asks for
#: fullscreen (measured: Chat came up fs=1), which covers the nav bar. These
#: are never fullscreen. Taking fullscreen OFF from outside is safe; putting
#: it ON from outside is what raised chromium's exit-full-screen bubble.
APP_WINDOW_PREFIX = "chrome-127.0.0.1__app.html"


def apply(con):
    """Set this window's fullscreen state. True when it is a surface that
    needs the nav bar (a taOS app, or the signed-in desktop)."""
    app_id = con.get("app_id") or ""
    if app_id.startswith(APP_WINDOW_PREFIX):
        if con.get("fullscreen_mode"):
            swaymsg("[con_id=%d] fullscreen disable" % con["id"])
        return True
    if app_id != KIOSK_APP_ID or loading(con.get("name")):
        return False
    want = wanted_fullscreen(con.get("name"))
    have = bool(con.get("fullscreen_mode"))
    if want != have:
        swaymsg("[con_id=%d] fullscreen %s" % (con["id"], "enable" if want else "disable"))
    return not want


def walk(node):
    if node.get("app_id"):
        yield node
    for child in node.get("nodes", []) + node.get("floating_nodes", []):
        yield from walk(child)


def scan():
    out = swaymsg("-t", "get_tree", "-r").stdout
    if out:
        needs_bar = [apply(con) for con in walk(json.loads(out))]
        if any(needs_bar):
            # A reload re-runs this script: restart the bar so it picks up a
            # changed config, as the old exec_always taos-kiosk-bar did.
            start_bar(replace=True)


def replace_previous():
    pidfile = os.path.join(run_dir(), "taos-kiosk-shellmode.pid")
    try:
        old = int(open(pidfile).read().strip())
        if old != os.getpid() and b"taos-kiosk-shellmode" in open(
                "/proc/%d/cmdline" % old, "rb").read():
            os.kill(old, 15)
    except (OSError, ValueError):
        pass
    with open(pidfile, "w") as f:
        f.write(str(os.getpid()))


def main():
    replace_previous()
    scan()
    proc = subprocess.Popen(
        ["swaymsg", "-t", "subscribe", "-m", "-r", '["window"]'],
        stdout=subprocess.PIPE, text=True)
    for line in proc.stdout:
        try:
            event = json.loads(line)
        except ValueError:
            continue
        if event.get("change") in ("new", "title", "focus", "fullscreen_mode"):
            if apply(event.get("container") or {}):
                start_bar()
    return proc.wait()


if __name__ == "__main__":
    sys.exit(main())
