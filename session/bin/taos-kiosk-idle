#!/bin/sh
# Idle -> display power off, inside the kiosk compositor.
#
# WHY A SCRIPT: sway's config grammar uses `;` as its OWN command separator, so
# an inline `exec_always pkill -x swayidle; swayidle -w ...` parses as TWO sway
# commands -- the exec runs `pkill` only and the rest is fed to sway as an
# unknown command, leaving the session with NO idle handling at all. Measured on
# the device 2026-09-16: swayidle was simply absent and the panel never blanked.
# Keeping the whole thing in a file means sway only ever sees one bare word.
set -eu

IDLE_SECS="${TAOS_KIOSK_IDLE_SECS:-30}"

# exec_always re-runs this on `swaymsg reload`, so drop a previous instance
# first or each reload leaves another swayidle racing the last one. -x matches
# the exact process name, so this shell (sh) is never a match for itself.
pkill -x swayidle 2>/dev/null || true

# `output * power off` is wlr-output-power-management: the panel is POWERED
# DOWN, not dimmed, and sway gates input while it is off so a touch wakes the
# screen rather than pressing whatever is under the finger.
# NO `resume` POWER-ON. This used to carry
#     resume 'swaymsg "output * power on"'
# which lit the panel on ANY input -- a stray touch in a pocket, a knee, the
# desk. Jay, from the glass: "Tap to wake just worked, i think it does sometimes
# just not when i want it to!" That unpredictability IS the bug; waking on
# everything and waking reliably are not the same property.
#
# taos-kiosk-dt2w owns the wake now and requires a deliberate double tap.
# swayidle still sees the touch as input, so it resumes and re-arms its own
# timeout -- which is why this does not hit the latch documented in
# taos-kiosk-power, where an IPC-only wake leaves swayidle stuck for good.
#
# THE POWER KEY REMAINS THE FALLBACK, bound with --locked in sway.conf: if the
# daemon is dead the screen is still reachable.
exec swayidle -w \
    timeout "$IDLE_SECS" 'swaymsg "output * power off"' \
    before-sleep         'swaymsg "output * power off"'
