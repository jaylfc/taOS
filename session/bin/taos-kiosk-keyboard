#!/bin/sh
# taos-kiosk-keyboard -- run squeekboard inside the kiosk session, themed.
# Started by /etc/taos/sway.d/50-keyboard.conf (written by `taos-session
# keyboard on`) as the session user. `--restart` replaces a running instance
# and returns; taos-session uses it after a theme change.
#
# squeekboard has no css override path and does not reload css, so the theme is
# applied by starting it with a private XDG_CONFIG_HOME whose gtk-3.0/gtk.css
# (GTK user priority beats the app's own css) is the variant css followed by
# the metrics css. dconf is linked back to the real one so the
# screen-keyboard-enabled gsetting is still read.
set -eu

usage() { echo "usage: taos-kiosk-keyboard [--restart]" >&2; exit 2; }
RESTART=0
case "${1:-}" in
    '') ;;
    --restart) RESTART=1 ;;
    *) usage ;;
esac
[ "$#" -le 1 ] || usage

# A caller outside the session (the controller service, a root shell) has no
# XDG_RUNTIME_DIR; the session user's is always /run/user/<uid>.
if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
    XDG_RUNTIME_DIR="/run/user/$(id -u)"
    export XDG_RUNTIME_DIR
fi
[ -d "$XDG_RUNTIME_DIR" ] || { echo "taos-kiosk-keyboard: no runtime dir $XDG_RUNTIME_DIR (no session for this user?)" >&2; exit 1; }
SELF="$0"
PIDFILE="$XDG_RUNTIME_DIR/taos-keyboard.pid"
KDIR="$XDG_RUNTIME_DIR/taos-keyboard"
BIN_DIRS="${TAOS_KEYBOARD_BIN_DIRS:-/usr/bin /usr/local/bin /usr/sbin}"
TAOS_SESSION="${TAOS_SESSION:-$(dirname "$SELF")/taos-session}"
[ -x "$TAOS_SESSION" ] || TAOS_SESSION="$(command -v taos-session || true)"
[ -n "$TAOS_SESSION" ] || { echo "taos-kiosk-keyboard: taos-session not found" >&2; exit 1; }

# Alpine's /usr/sbin is a symlink to /usr/bin, Debian's is not: probe, do not
# assume.
BIN=""
for d in $BIN_DIRS; do
    [ -x "$d/squeekboard" ] && BIN="$d/squeekboard" && break
done
[ -n "$BIN" ] || { echo "taos-kiosk-keyboard: no squeekboard binary found in: $BIN_DIRS" >&2; exit 1; }

# Replace the previous instance by PID. The pidfile names one process and the
# check reads that one process's name, so nothing here matches a process list.
stop_old() {
    [ -r "$PIDFILE" ] || return 0
    read -r _old < "$PIDFILE" || _old=""
    case "$_old" in
        ''|*[!0-9]*) return 0 ;;
    esac
    [ "$_old" != "$$" ] || return 0
    [ -r "/proc/$_old/comm" ] || return 0
    read -r _comm < "/proc/$_old/comm" || _comm=""
    case "$_comm" in
        squeekboard|taos-kiosk-keyb*) ;;
        *) return 0 ;;
    esac
    kill "$_old" 2>/dev/null || return 0
    _i=0
    while kill -0 "$_old" 2>/dev/null && [ "$_i" -lt 30 ]; do
        sleep 0.1 2>/dev/null || sleep 1
        _i=$((_i + 1))
    done
}

if [ "$RESTART" = 1 ]; then
    # Have sway start it, so the keyboard belongs to the kiosk session. Started
    # as a child of this call it sits in the caller's login session (su from
    # root, ssh) and logind kills it when that session closes: measured on the
    # handset, "session-c199.scope: Killing process (squeekboard)" seconds
    # after a theme change. The new instance stops the old one itself.
    SOCK="${SWAYSOCK:-}"
    if [ -z "$SOCK" ]; then
        for s in "$XDG_RUNTIME_DIR"/sway-ipc.*.sock; do
            [ -S "$s" ] && SOCK="$s" && break
        done
    fi
    case "$SELF" in
        /*) ;;
        *) SELF="$(cd "$(dirname "$SELF")" && pwd)/$(basename "$SELF")" ;;
    esac
    if [ -n "$SOCK" ] && command -v swaymsg >/dev/null 2>&1; then
        SWAYSOCK="$SOCK" swaymsg exec -- "$SELF" >/dev/null || {
            echo "taos-kiosk-keyboard: swaymsg exec failed" >&2; exit 1; }
        exit 0
    fi
    # No compositor to ask (tests, a bare shell): start it directly.
    stop_old
    rm -f "$PIDFILE"
    if command -v setsid >/dev/null 2>&1; then
        setsid "$SELF" </dev/null >/dev/null 2>&1 &
    else
        "$SELF" </dev/null >/dev/null 2>&1 &
    fi
    exit 0
fi

# The theme is looked up by taos-session only, so the rules exist once. Exit 3
# means it fell back to the default (already warned on stderr).
if RES="$("$TAOS_SESSION" resolve-theme)"; then :; else
    rc=$?
    [ "$rc" = 3 ] || { echo "taos-kiosk-keyboard: no usable theme (taos-session resolve-theme exit $rc)" >&2; exit 1; }
fi
VCSS="$(printf '%s\n' "$RES" | sed -n 2p)"
MCSS="$(printf '%s\n' "$RES" | sed -n 3p)"
[ -r "$VCSS" ] && [ -r "$MCSS" ] || { echo "taos-kiosk-keyboard: resolved css unreadable" >&2; exit 1; }

# Two instances started together would both read the old pid before either
# wrote the pidfile, leaving one keyboard running and unrecorded. Serialize
# stop_old + pidfile write with an atomic mkdir lock. Waits up to ~5s; if the
# lock is still held then, it is treated as stale and taken over (no age
# check). Released before exec, so squeekboard inherits nothing from it.
LOCK="$XDG_RUNTIME_DIR/taos-keyboard.lock"
LOCKED=0
unlock() { [ "$LOCKED" = 1 ] && rmdir "$LOCK" 2>/dev/null; LOCKED=0; return 0; }
_i=0
until mkdir "$LOCK" 2>/dev/null; do
    if [ "$_i" -ge 50 ]; then
        rmdir "$LOCK" 2>/dev/null || true
        mkdir "$LOCK" 2>/dev/null || true
        break
    fi
    sleep 0.1 2>/dev/null || sleep 1
    _i=$((_i + 1))
done
LOCKED=1
trap unlock EXIT
trap 'exit 1' INT TERM HUP

stop_old
mkdir -p "$KDIR/gtk-3.0"
cat "$VCSS" "$MCSS" > "$KDIR/gtk-3.0/gtk.css.$$"
mv -f "$KDIR/gtk-3.0/gtk.css.$$" "$KDIR/gtk-3.0/gtk.css"
ln -sfn "${XDG_CONFIG_HOME:-$HOME/.config}/dconf" "$KDIR/dconf"

# A restart from root has no compositor variable; take the socket that exists.
if [ -z "${WAYLAND_DISPLAY:-}" ]; then
    for s in "$XDG_RUNTIME_DIR"/wayland-[0-9]*; do
        case "$s" in *.lock) continue ;; esac
        if [ -S "$s" ]; then
            WAYLAND_DISPLAY="${s##*/}"
            export WAYLAND_DISPLAY
            break
        fi
    done
fi

echo "$$" > "$PIDFILE"
unlock
trap - EXIT INT TERM HUP
XDG_CONFIG_HOME="$KDIR"
export XDG_CONFIG_HOME
exec "$BIN"
