#!/bin/sh
# taos-app-launch <name> <url> -- open a taOS app in its OWN window.
#
# This is the shape every taOS app is meant to take: one chromium window per
# app, so the compositor sees it as its own toplevel and it lands in the task
# switcher beside Linux apps and (later) Android ones. One browser, N windows.
#
# WHY systemd-run AND NOT nohup/setsid: a process started over ssh dies with
# the session even under setsid -- measured, twice. A transient unit is owned
# by systemd, so it outlives whoever asked for it.
#
# ⚠ --kiosk, AND NOT A COMPOSITOR FULLSCREEN ON TOP OF IT. Jay: "i loaded the
# camera and got a chrome exit full screen dialog". That is chromium's
# exclusive-access bubble, and it fires when something ELSE puts the window
# fullscreen -- a sway `for_window ... fullscreen enable` rule I had added.
# chromium's own kiosk mode fills the output and shows no chrome at all, which
# is the same flag set taos-kiosk-launch already uses for the lock screen and
# which has never produced a dialog. The sway rule is gone.
#
# ⚠ ONE WORKSPACE PER APP, not fullscreen. sway TILES, so an app launched
# beside the kiosk gets half the screen -- Jay saw the camera and the lock
# screen side by side in a vertical split. `fullscreen enable` did not settle
# it either. Switching to the app's own workspace first means the app opens
# ALONE and fills the output, which is what a phone does, and it gives the
# task switcher its unit of work for free: one workspace, one app.
#
# ⚠ THE APP ID. chromium on wayland derives app_id from the URL's HOST and
# DROPS THE PORT, so every app served from 127.0.0.1 would collide on
# `chrome-127.0.0.1__-Default` and be indistinguishable in a taskbar. Each app
# therefore gets its own hostname alias in /etc/hosts (camera.taos -> 127.0.0.1)
# and is opened by that name, which makes the app_id distinct AND readable.
set -eu

NAME="${1:?usage: taos-app-launch <name> <url>}"
URL="${2:?usage: taos-app-launch <name> <url>}"

TAOS_UID="$(id -u taos)"
RUNDIR="/run/user/${TAOS_UID}"
# The compositor's socket, read from what is actually running rather than
# assumed: wayland-1 is the usual name but nothing guarantees it.
WD="$(cd "$RUNDIR" 2>/dev/null && ls wayland-[0-9]* 2>/dev/null | grep -v '\.lock$' | head -1)"
[ -n "${WD:-}" ] || { echo "no wayland socket in $RUNDIR -- is the kiosk session up?" >&2; exit 1; }

# Switch first, launch second: chromium opens on whatever workspace is current
# when its window maps.
swaymsg_as_taos() {
  # `su taos`, NOT `su "$(id -nu $TAOS_UID)"`: busybox id refuses a numeric
  # argument ("id: unknown user 999"), the switch failed silently behind the
  # `|| true`, and the app opened on the kiosk's workspace -- which is exactly
  # the vertical split Jay saw.
  su taos -s /bin/sh -c \
    "XDG_RUNTIME_DIR=$RUNDIR SWAYSOCK=$SWAYSOCK swaymsg $1" >/dev/null 2>&1 || true
}
SWAYSOCK="$(ls "$RUNDIR"/sway-ipc.*.sock 2>/dev/null | head -1)"
[ -n "$SWAYSOCK" ] || { echo "no sway ipc socket in $RUNDIR" >&2; exit 1; }
# ALREADY RUNNING? BRING IT FORWARD, do not try to start it twice.
#
# Jay pressed the lock screen's camera button twice in six seconds. The second
# press asked systemd-run for a unit name that already existed, which fails --
# while the route that triggered it had already answered 200, so the screen
# said nothing either way. Pressing an app's icon when the app is open should
# simply show it, which is what every phone does.
if systemctl is-active --quiet "taos-app-${NAME}.service"; then
  swaymsg_as_taos "workspace app-${NAME}"
  echo "taos-app-${NAME} already running; switched to it"
  exit 0
fi

swaymsg_as_taos "workspace app-${NAME}"

exec systemd-run \
  --unit="taos-app-${NAME}" \
  --collect \
  --uid="$TAOS_UID" \
  --setenv=XDG_RUNTIME_DIR="$RUNDIR" \
  --setenv=WAYLAND_DISPLAY="$WD" \
  --setenv=XDG_SESSION_TYPE=wayland \
  --setenv=SWAYSOCK="$SWAYSOCK" \
  /usr/bin/chromium \
    --kiosk \
    --app="$URL" \
    --ozone-platform=wayland \
    --no-first-run \
    --no-default-browser-check \
    --disable-features=TranslateUI \
    --disable-pinch \
    --overscroll-history-navigation=0 \
    --user-data-dir="/home/taos/.config/chromium-app-${NAME}"
