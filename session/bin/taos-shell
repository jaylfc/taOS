#!/bin/sh
# The nav bar's three buttons. Runs in the sway session as taos (waybar's
# on-click), so it has SWAYSOCK and WAYLAND_DISPLAY already.
#   back     Alt+Left to the focused window: chromium's back; a native app
#            that binds nothing to it simply ignores it.
#   home     the taOS desktop, workspace 1, then F13: the PWA's home key
#            (taOS useHomeKey), so the open app goes to the background and
#            the home screen shows, as on Android. Nothing else binds F13.
#   recents  the switcher: taOS app switcher, workspace 1 then F14 (taOS useSwitcherKey).
set -eu
case "${1:-}" in
back)
    exec wtype -M alt -k Left -m alt
    ;;
home)
    swaymsg -q workspace 1
    exec wtype -k F13
    ;;
recents)
    swaymsg -q workspace 1
    exec wtype -k F14
    ;;
*)
    echo "usage: taos-shell back|home|recents" >&2
    exit 2
    ;;
esac
