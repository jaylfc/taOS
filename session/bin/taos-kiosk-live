#!/bin/sh
# Keep the panel awake while something LIVE is on the lock screen.
#
# Jay: "the screen should not sleep whilst a live event (like the call
# transcript) is on screen". The 30 s blank is swayidle (taos-kiosk-idle), and
# swayidle -w honours Wayland idle inhibitors, so this holds sway's own
# `inhibit_idle open` on the lock screen's window for as long as the event is
# live and drops it after. Dropping it restarts the idle timer, so the panel
# blanks 30 s after the call ends, not the instant it ends.
#
# WHY POLL THE CONTROLLER. What is live is the page's state, and the
# controller is where that state is authoritative (/auth/lock-call). A second
# idea of "is a call up" in this script would be a second copy to disagree.
# It is a loopback GET every 2 s; a 404 (the call demo switched off) reads as
# nothing live.
#
# LIVE = ringing, with the PA, or on the call. NOT "ended": that is a pill
# on its way out, and holding the panel on it would keep a phone awake on a
# call nobody is in.
set -eu

RUN="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
PIDFILE="$RUN/taos-kiosk-live.pid"

# exec_always re-runs this on every `swaymsg reload`; replace the previous
# copy by PID, checked against its cmdline (not `pkill -f`, which matches the
# shell doing the matching).
if [ -r "$PIDFILE" ]; then
    old="$(cat "$PIDFILE" 2>/dev/null || true)"
    if [ -n "$old" ] && [ "$old" != "$$" ] \
        && grep -qa 'taos-kiosk-live' "/proc/$old/cmdline" 2>/dev/null; then
        kill "$old" 2>/dev/null || true
    fi
fi
echo "$$" > "$PIDFILE"

URL="http://127.0.0.1:${TAOS_PORT:-6969}/auth/lock-call"
# The lock screen's window, measured on the handset: app_id
# chrome-127.0.0.1__-Default. Matched as a prefix so a profile rename does not
# silently disarm this.
WINDOW='[app_id="^chrome-127\.0\.0\.1__"]'

live() {
    state="$(curl -s --max-time 2 "$URL" 2>/dev/null \
        | sed -n 's/.*"state": *"\([a-z-]*\)".*/\1/p' | head -1)"
    case "$state" in ringing|pa|live) return 0 ;; esac
    return 1
}

held=0
# Start from a known state: a previous copy killed mid-call may have left the
# inhibitor open.
swaymsg "$WINDOW inhibit_idle none" >/dev/null 2>&1 || true
while :; do
    want=0
    live && want=1
    if [ "$want" != "$held" ]; then
        if [ "$want" = 1 ]; then
            swaymsg "$WINDOW inhibit_idle open" >/dev/null 2>&1 && held=1
        else
            swaymsg "$WINDOW inhibit_idle none" >/dev/null 2>&1 && held=0
        fi
    fi
    sleep 2
done
