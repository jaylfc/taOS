#!/bin/sh
# greetd's greeter command: gtkgreet inside a cage kiosk, on the display GPU only.
# Env (tests): TAOS_DISPLAY_NODE (default /dev/dri/taos-display).
set -u
node=${TAOS_DISPLAY_NODE:-/dev/dri/taos-display}
if [ -e "$node" ]; then
    WLR_DRM_DEVICES=$(readlink -f "$node")
    export WLR_DRM_DEVICES
else
    unset WLR_DRM_DEVICES
    echo "taos greeter: $node missing; cage picks its own GPU" >&2
fi
# -s lets Ctrl+Alt+Fn switch to the text consoles. No -l: cage has no layer shell.
exec cage -s -d -- gtkgreet -s /etc/taos/greetd/gtkgreet.css
