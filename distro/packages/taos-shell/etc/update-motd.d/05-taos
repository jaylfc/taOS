#!/bin/sh
# taOS login motd: gradient logo plus a short system summary. Run by
# pam_motd (sshd and login). No network calls; must stay fast.
share=${TAOS_SHELL_SHARE:-/usr/share/taos-shell}
osrel=${OS_RELEASE:-/etc/os-release}

# Colour unless the terminal is dumb or NO_COLOR is set.
color=1
[ "${TERM:-}" = dumb ] && color=0
[ -n "${NO_COLOR:-}" ] && color=0
if [ "$color" = 1 ]; then
    esc=$(printf '\033')
    reset="${esc}[0m"
    key="${esc}[38;5;51m"
    dim="${esc}[38;5;244m"
else
    reset=""; key=""; dim=""; esc=""
fi

# Logo: top-to-bottom 256-colour gradient, violet to cyan.
logo="$share/logo.txt"
if [ -r "$logo" ]; then
    n=0
    while IFS= read -r line; do
        if [ "$color" = 1 ]; then
            case $n in
                0) c=141 ;; 1) c=135 ;; 2) c=99 ;; 3) c=63 ;; 4) c=39 ;; 5) c=45 ;; *) c=51 ;;
            esac
            printf '%s[1;38;5;%sm%s%s\n' "$esc" "$c" "$line" "$reset"
        else
            printf '%s\n' "$line"
        fi
        n=$((n + 1))
    done < "$logo"
else
    printf 'taOS\n'
fi
printf '\n  %syour agents, your hardware%s\n' "$key" "$reset"
printf '\n'

row() { printf '  %s%-13s%s %s\n' "$key" "$1" "$reset" "$2"; }

host=$(cat /proc/sys/kernel/hostname 2>/dev/null || echo unknown)
pretty=taOS
if [ -r "$osrel" ]; then
    pretty=$(sed -n 's/^PRETTY_NAME=//p' "$osrel" | head -n 1 | tr -d '"')
    [ -n "$pretty" ] || pretty=taOS
fi

up=$(cut -d. -f1 /proc/uptime 2>/dev/null || echo 0)
d=$((up / 86400)); h=$(((up % 86400) / 3600)); m=$(((up % 3600) / 60))
if [ "$d" -gt 0 ]; then uptime="${d}d ${h}h ${m}m"; elif [ "$h" -gt 0 ]; then uptime="${h}h ${m}m"; else uptime="${m}m"; fi

load=$(cut -d' ' -f1-3 /proc/loadavg 2>/dev/null || echo "?")

mem=$(awk '/^MemTotal:/{t=$2} /^MemAvailable:/{a=$2} END{if(t>0) printf "%.1f / %.1f GiB", (t-a)/1048576, t/1048576; else print "?"}' /proc/meminfo 2>/dev/null)

disk=$(df -P -h / 2>/dev/null | awk 'NR==2{print $3 " / " $2 " (" $5 ")"}')
[ -n "$disk" ] || disk="?"

# IPv4: no network calls. TAOS_MOTD_IP4 overrides the lookup and TAOS_MOTD_SYSNET
# points at a fake /sys/class/net (both for tests).
if [ -n "${TAOS_MOTD_IP4+x}" ]; then
    ip=$TAOS_MOTD_IP4
else
    ip=""
    if command -v ip >/dev/null 2>&1; then
        ip=$(ip -4 route get 1.1.1.1 2>/dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p' | head -n 1)
    fi
    if [ -z "$ip" ] && command -v hostname >/dev/null 2>&1; then
        ip=$(hostname -I 2>/dev/null | cut -d' ' -f1)
    fi
fi
if [ -z "$ip" ]; then
    # No address yet: the link may still be coming up (DHCP runs after login
    # starts), so tell "connecting" apart from truly offline.
    ip="offline"
    sysnet=${TAOS_MOTD_SYSNET:-/sys/class/net}
    for n in "$sysnet"/*; do
        [ -e "$n" ] || continue
        [ "${n##*/}" = lo ] && continue
        st=""; ca=""
        [ -r "$n/operstate" ] && read -r st < "$n/operstate" 2>/dev/null
        [ -r "$n/carrier" ] && read -r ca < "$n/carrier" 2>/dev/null
        if [ "$st" = up ] || [ "$ca" = 1 ]; then ip="connecting..."; break; fi
    done
fi

svc="not installed"
for u in /etc/systemd/system /usr/lib/systemd/system /lib/systemd/system; do
    if [ -e "$u/tinyagentos.service" ]; then svc="stopped"; break; fi
done
if [ "$svc" = stopped ] && command -v systemctl >/dev/null 2>&1; then
    if systemctl is-active --quiet tinyagentos.service 2>/dev/null; then svc="running"; fi
fi

row "Hostname" "$host"
row "System" "$pretty"
row "Uptime" "$uptime"
row "Load" "$load"
row "Memory" "$mem"
row "Disk /" "$disk"
row "IPv4" "$ip"
row "taOS service" "$svc"
kern=$(cat /proc/sys/kernel/osrelease 2>/dev/null || echo unknown)
printf '\n  %sKernel %s%s\n' "$dim" "$kern" "$reset"
printf '  %sFree software, no warranty. Licences: /usr/share/doc/*/copyright%s\n\n' "$dim" "$reset"
exit 0
