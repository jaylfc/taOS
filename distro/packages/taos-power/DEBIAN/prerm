#!/bin/sh
set -e
case "$1" in
    remove|deconfigure)
        if command -v systemctl >/dev/null 2>&1; then
            if [ -d /run/systemd/system ]; then
                systemctl stop taos-power.service >/dev/null 2>&1 || true
            fi
            systemctl disable taos-power.service >/dev/null 2>&1 || true
        fi
        ;;
esac
exit 0
