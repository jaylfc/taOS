#!/bin/sh
# taos-gpu: choose which GPU drives the display; NVIDIA cards stay compute only
# by default. POSIX sh, reads sysfs only. Roots are overridable for tests:
#   SYSFS_ROOT (default /sys), ETC_ROOT (default /etc),
#   TAOS_GPU_NO_APPLY=1 skips udevadm and update-initramfs.
#
# GPUs come from PCI class 0x03xxxx devices (so driverless cards stay listed)
# plus non-PCI class/drm cards (platform, kind integrated).
# Kind rule: "integrated" = vendor Intel, or AMD with boot_vga=1 on PCI bus 00;
# everything else is "discrete". Compute-only = every GPU except the display GPU.
set -eu

SYSFS_ROOT=${SYSFS_ROOT:-/sys}
if [ -n "${ETC_ROOT:-}" ]; then
    TEST_MODE=1
else
    TEST_MODE=0
    ETC_ROOT=/etc
fi
CONF="$ETC_ROOT/taos/gpu.conf"

usage() {
    cat <<USAGE
Usage: taos-gpu <command>
  list [--json]            list GPUs and mark the display GPU
  status [--json]          show the policy, display GPU and compute-only GPUs
  set-display <auto|PCI>   choose the display GPU (PCI address from 'list'), then apply
  apply                    regenerate udev rule, session env and modprobe config
  driver <command>         official vendor drivers (status, install, remove; see 'taos-gpu driver --help')
  --help                   show this help
Changes take effect after a reboot.
USAGE
}

die() { echo "taos-gpu: $1" >&2; exit "${2:-1}"; }

need_root() {
    if [ "$TEST_MODE" -eq 0 ] && [ "$(id -u)" -ne 0 ]; then
        die "must be run as root" 1
    fi
}

nl='
'
GPUS=""
DISP=""
CHANGED=0

# Fill CONN (comma list) with connected connectors of card <name>; <extra> is
# the card dir under the device (drm/<card>) when there is one.
add_conn() {
    cname=$1
    cextra=$2
    for c in "$SYSFS_ROOT"/class/drm/"$cname"-* "$SYSFS_ROOT/class/drm/$cname/$cname"-* "$cextra/$cname"-*; do
        [ -e "$c" ] || continue
        [ "$(cat "$c/status" 2>/dev/null)" = connected ] || continue
        cn=${c##*/}
        cn=${cn#"$cname"-}
        case ",$CONN," in *",$cn,"*) continue ;; esac
        CONN="${CONN:+$CONN,}$cn"
    done
}

vendor_name() { # vendor id -> display name
    case "$1" in
        0x8086) echo Intel ;;
        0x1002) echo AMD ;;
        0x10de) echo NVIDIA ;;
        *) echo "$1" ;;
    esac
}

driver_of() { # device dir -> driver name or none
    if [ -L "$1/driver" ]; then
        basename "$(readlink "$1/driver")"
    else
        echo none
    fi
}

# Fill GPUS with one record per GPU: pci|vendor|driver|kind|boot|connectors(comma)
# Pass 1 walks PCI display-class devices (class 0x03xxxx), so a card with no
# driver bound (and so no class/drm node) is still listed. Pass 2 adds
# non-PCI GPUs (ARM boards) found only through class/drm.
scan() {
    GPUS=""
    for dev in "$SYSFS_ROOT"/bus/pci/devices/*; do
        [ -e "$dev" ] || continue
        pci=${dev##*/}
        cls=$(cat "$dev/class" 2>/dev/null || echo "")
        case "$cls" in 0x03*) ;; *) continue ;; esac
        vid=$(cat "$dev/vendor" 2>/dev/null || echo unknown)
        ven=$(vendor_name "$vid")
        drv=$(driver_of "$dev")
        boot=$(cat "$dev/boot_vga" 2>/dev/null || echo 0)
        [ "$boot" = 1 ] || boot=0
        kind=discrete
        if [ "$ven" = Intel ]; then
            kind=integrated
        elif [ "$ven" = AMD ] && [ "$boot" = 1 ]; then
            case "$pci" in ????:00:*) kind=integrated ;; esac
        fi
        CONN=""
        for card in "$dev"/drm/card[0-9]*; do
            [ -e "$card" ] || continue
            cname=${card##*/}
            case "$cname" in *-*) continue ;; esac
            add_conn "$cname" "$card"
        done
        GPUS="$GPUS$pci|$ven|$drv|$kind|$boot|$CONN$nl"
    done
    for d in "$SYSFS_ROOT"/class/drm/card[0-9]*; do
        [ -e "$d" ] || continue
        name=${d##*/}
        case "$name" in *-*) continue ;; esac
        dev="$d/device"
        [ -e "$dev" ] || continue
        pci=$(basename "$(readlink -f "$dev")")
        case "$nl$GPUS" in *"$nl$pci|"*) continue ;; esac
        drv=$(driver_of "$dev")
        CONN=""
        for d2 in "$SYSFS_ROOT"/class/drm/card[0-9]*; do
            [ -e "$d2" ] || continue
            n2=${d2##*/}
            case "$n2" in *-*) continue ;; esac
            [ "$(basename "$(readlink -f "$d2/device")")" = "$pci" ] || continue
            add_conn "$n2" "$d2"
        done
        GPUS="$GPUS$pci|platform|$drv|integrated|0|$CONN$nl"
    done
}

# Read DISPLAY_GPU from gpu.conf without sourcing it.
policy() {
    p=""
    if [ -r "$CONF" ]; then
        p=$(sed -n 's/^DISPLAY_GPU=//p' "$CONF" | tail -n 1)
    fi
    echo "${p:-auto}"
}

# Set DISP to the resolved display GPU PCI address (empty when no GPUs).
resolve() {
    DISP=""
    [ -n "$GPUS" ] || return 0
    pol=$(policy)
    if [ "$pol" != auto ]; then
        while IFS='|' read -r pci ven drv kind boot conn; do
            [ -n "$pci" ] || continue
            if [ "$pci" = "$pol" ]; then DISP=$pci; return 0; fi
        done <<EOF
$GPUS
EOF
        echo "taos-gpu: configured GPU $pol not found, using auto" >&2
    fi
    # auto: (1) integrated with a connected connector, (2) any integrated,
    # (3) boot_vga GPU, (4) first GPU. Never a discrete card while an
    # integrated one exists, and never a GPU with no driver bound (it cannot
    # drive a screen).
    for rule in 1 2 3 4; do
        while IFS='|' read -r pci ven drv kind boot conn; do
            [ -n "$pci" ] || continue
            [ "$drv" != none ] || continue
            case $rule in
                1) [ "$kind" = integrated ] && [ -n "$conn" ] || continue ;;
                2) [ "$kind" = integrated ] || continue ;;
                3) [ "$boot" = 1 ] || continue ;;
            esac
            DISP=$pci
            return 0
        done <<EOF
$GPUS
EOF
    done
}

vendor_of() { # pci -> vendor name
    while IFS='|' read -r pci ven drv kind boot conn; do
        if [ "$pci" = "$1" ]; then echo "$ven"; return 0; fi
    done <<EOF
$GPUS
EOF
}

json_arr() { # comma list -> JSON array of strings
    out=""
    oldifs=$IFS
    IFS=,
    for item in $1; do
        out="${out:+$out, }\"$item\""
    done
    IFS=$oldifs
    printf '[%s]' "$out"
}

cmd_list() {
    json=0
    [ "${1:-}" = "--json" ] && json=1
    scan
    resolve
    if [ "$json" -eq 1 ]; then
        printf '['
        sep=""
        while IFS='|' read -r pci ven drv kind boot conn; do
            [ -n "$pci" ] || continue
            b=false; [ "$boot" = 1 ] && b=true
            d=false; [ "$pci" = "$DISP" ] && d=true
            printf '%s{"pci": "%s", "vendor": "%s", "driver": "%s", "kind": "%s", "boot_vga": %s, "connected": %s, "display": %s}' \
                "$sep" "$pci" "$ven" "$drv" "$kind" "$b" "$(json_arr "$conn")" "$d"
            sep=", "
        done <<EOF
$GPUS
EOF
        printf ']\n'
        return 0
    fi
    while IFS='|' read -r pci ven drv kind boot conn; do
        [ -n "$pci" ] || continue
        mark=""
        [ "$pci" = "$DISP" ] && mark="  [display]"
        printf '%s  %s  %s  %s  boot_vga=%s  connected=%s%s\n' \
            "$pci" "$ven" "$drv" "$kind" "$boot" "${conn:--}" "$mark"
    done <<EOF
$GPUS
EOF
}

cmd_status() {
    json=0
    [ "${1:-}" = "--json" ] && json=1
    scan
    resolve
    pol=$(policy)
    comp=""
    while IFS='|' read -r pci ven drv kind boot conn; do
        [ -n "$pci" ] || continue
        [ "$pci" = "$DISP" ] || comp="${comp:+$comp,}$pci"
    done <<EOF
$GPUS
EOF
    if [ "$json" -eq 1 ]; then
        if [ -n "$DISP" ]; then dj="\"$DISP\""; else dj=null; fi
        printf '{"policy": "%s", "display": %s, "compute_only": %s}\n' \
            "$pol" "$dj" "$(json_arr "$comp")"
        return 0
    fi
    echo "policy: $pol"
    if [ -n "$DISP" ]; then
        echo "display: $DISP ($(vendor_of "$DISP"))"
    else
        echo "display: none (no GPU with a display driver found)"
    fi
    echo "compute-only: ${comp:-none}" | tr ',' ' '
}

# write_atomic <path>: stdin -> path via temp + mv. Sets CHANGED=1 if content differs.
write_atomic() {
    dest=$1
    mkdir -p "$(dirname "$dest")"
    tmp="$dest.tmp.$$"
    cat > "$tmp"
    if [ -f "$dest" ] && cmp -s "$tmp" "$dest"; then
        rm -f "$tmp"
        CHANGED=0
    else
        mv -f "$tmp" "$dest"
        CHANGED=1
    fi
}

cmd_apply() {
    need_root
    scan
    resolve
    if [ -z "$DISP" ]; then
        if [ -z "$GPUS" ]; then
            echo "taos-gpu: no GPU found, nothing to configure"
        else
            echo "taos-gpu: no GPU with a display driver loaded, nothing to configure"
        fi
        return 0
    fi
    rules="$ETC_ROOT/udev/rules.d/61-taos-display-gpu.rules"
    envf="$ETC_ROOT/taos/session.env.d/10-gpu.env"
    modf="$ETC_ROOT/modprobe.d/taos-gpu.conf"

    write_atomic "$rules" <<EOF
# Generated by taos-gpu. Do not edit; use 'taos-gpu set-display'.
SUBSYSTEM=="drm", KERNEL=="card[0-9]*", KERNELS=="$DISP", SYMLINK+="dri/taos-display"
EOF
    write_atomic "$envf" <<EOF
WLR_DRM_DEVICES=/dev/dri/taos-display
EOF
    has_nv=0
    while IFS='|' read -r pci ven drv kind boot conn; do
        if [ "$ven" = NVIDIA ]; then has_nv=1; fi
    done <<EOF
$GPUS
EOF
    nvd=$(conf_get NVIDIA_DRIVER)
    if [ "$has_nv" -eq 0 ]; then
        write_atomic "$modf" <<EOF
# Generated by taos-gpu. No NVIDIA GPU present, nothing to configure.
EOF
    elif [ "$(vendor_of "$DISP")" = NVIDIA ]; then
        case "$nvd" in
            official)
                write_atomic "$modf" <<EOF
# Generated by taos-gpu. An NVIDIA GPU drives the display with the official driver.
blacklist nouveau
options nvidia-drm modeset=1
EOF
                ;;
            open)
                write_atomic "$modf" <<EOF
# Generated by taos-gpu. An NVIDIA GPU drives the display with the open-source driver.
EOF
                ;;
            *)
                write_atomic "$modf" <<EOF
# Generated by taos-gpu. An NVIDIA GPU drives the display.
options nvidia-drm modeset=1
EOF
                ;;
        esac
    else
        write_atomic "$modf" <<EOF
# Generated by taos-gpu. NVIDIA cards are compute only: keep them off the
# display. The proprietary driver still loads for CUDA.
blacklist nouveau
options nouveau modeset=0
options nvidia-drm modeset=0
EOF
    fi
    mod_changed=$CHANGED

    if [ "${TAOS_GPU_NO_APPLY:-0}" != 1 ]; then
        if command -v udevadm >/dev/null 2>&1; then
            udevadm control --reload >/dev/null 2>&1 || true
            udevadm trigger --subsystem-match=drm >/dev/null 2>&1 || true
        fi
        if [ "$mod_changed" -eq 1 ]; then
            if command -v update-initramfs >/dev/null 2>&1; then
                update-initramfs -u >/dev/null 2>&1 || true
            else
                echo "taos-gpu: no update-initramfs here; rebuild your initramfs if your base needs it"
            fi
        fi
    fi
    echo "taos-gpu: display GPU is $DISP"
    if [ "$mod_changed" -eq 1 ]; then echo "taos-gpu: reboot required"; fi
    return 0
}

cmd_set_display() {
    [ $# -eq 1 ] || die "usage: taos-gpu set-display <auto|PCI address>" 2
    need_root
    want=$1
    if [ "$want" != auto ]; then
        scan
        ok=0
        while IFS='|' read -r pci ven drv kind boot conn; do
            if [ "$pci" = "$want" ]; then
                ok=1
                if [ "$drv" = none ]; then
                    echo "taos-gpu: warning: $want has no display driver loaded; it cannot drive a screen until one is" >&2
                fi
            fi
        done <<EOF
$GPUS
EOF
        [ "$ok" -eq 1 ] || die "'$want' is not a listed GPU (see 'taos-gpu list')" 2
    fi
    conf_set DISPLAY_GPU "$want"
    cmd_apply
}

# ---------------------------------------------------------------------------
# driver: official vendor GPU drivers (step 4).
#
# NVIDIA official driver comes from NVIDIA's own apt repo (amd64 only) and is
# the default when an NVIDIA GPU is present; the open-source driver is the
# opt-out. Every external command goes through run(), so --dry-run (or
# TAOS_GPU_DRY_RUN=1) prints the exact plan instead of executing it.
# Probes overridable for tests: TAOS_GPU_ARCH, TAOS_GPU_SB_STATE
# (enabled|disabled|unknown), TAOS_GPU_FAKE_INSTALLED ("pkg1 pkg2=1.2"),
# TAOS_GPU_MOK_STATE (enrolled|pending|not_enrolled|missing|unknown),
# TAOS_GPU_DKMS_KEY, TAOS_GPU_KEYRING_FILE (use this file instead of
# downloading), TAOS_GPU_KEYRING_SHA256 (override the expected hash).
# ---------------------------------------------------------------------------
NV_BASE=https://developer.download.nvidia.com/compute/cuda/repos/debian13/x86_64
NV_KEYRING_DEB=cuda-keyring_1.1-1_all.deb
NV_KEYRING_SHA256=d0d4ef986a44400f9db33c600ef33a985175e7cc63d805a10e1839c7a1e78f5f
NV_KEYRING_GPG=/usr/share/keyrings/cuda-archive-keyring.gpg
# The keyring deb ships its own sources file; taos-nvidia.list is only a
# fallback written when that file is missing.
NV_LIST_DEB=cuda-debian13-x86_64.list
NV_LIST_TAOS=taos-nvidia.list
DRY=0
TMPD=""

# Print a command in plan form, quoting only what needs it.
show_cmd() {
    printf '+'
    for a in "$@"; do
        case $a in
            ''|*[!A-Za-z0-9_./:=@%+,-]*) printf " '%s'" "$a" ;;
            *) printf ' %s' "$a" ;;
        esac
    done
    printf '\n'
}

run() {
    if [ "$DRY" -eq 1 ]; then
        show_cmd "$@"
        return 0
    fi
    "$@"
}

plan() { # dry-run only comment line
    if [ "$DRY" -eq 1 ]; then echo "+ # $*"; fi
    return 0
}

say() { echo "taos-gpu: $*"; }

cleanup_tmp() {
    if [ -n "$TMPD" ] && [ "$DRY" -eq 0 ]; then rm -rf "$TMPD"; fi
}

dry_init() {
    DRY=0
    if [ "${TAOS_GPU_DRY_RUN:-0}" = 1 ]; then DRY=1; fi
}

host_arch() {
    if [ -n "${TAOS_GPU_ARCH:-}" ]; then echo "$TAOS_GPU_ARCH"; return 0; fi
    if command -v dpkg >/dev/null 2>&1; then dpkg --print-architecture; return 0; fi
    case "$(uname -m)" in
        x86_64) echo amd64 ;;
        aarch64) echo arm64 ;;
        *) uname -m ;;
    esac
}

pkg_installed() {
    if [ -n "${TAOS_GPU_FAKE_INSTALLED+x}" ]; then
        for e in $TAOS_GPU_FAKE_INSTALLED; do
            [ "${e%%=*}" = "$1" ] && return 0
        done
        return 1
    fi
    s=$(dpkg-query -W -f='${db:Status-Abbrev}' "$1" 2>/dev/null) || return 1
    case $s in ii*) return 0 ;; esac
    return 1
}

pkg_version() { # empty when not installed
    pkg_installed "$1" || return 0
    if [ -n "${TAOS_GPU_FAKE_INSTALLED+x}" ]; then
        for e in $TAOS_GPU_FAKE_INSTALLED; do
            if [ "${e%%=*}" = "$1" ]; then
                case $e in *=*) echo "${e#*=}" ;; *) echo installed ;; esac
                return 0
            fi
        done
        return 0
    fi
    dpkg-query -W -f='${Version}' "$1" 2>/dev/null || true
}

installed_pinning() { # installed nvidia-driver-pinning-* package names
    if [ -n "${TAOS_GPU_FAKE_INSTALLED+x}" ]; then
        for e in $TAOS_GPU_FAKE_INSTALLED; do
            case ${e%%=*} in nvidia-driver-pinning-*) echo "${e%%=*}" ;; esac
        done
        return 0
    fi
    dpkg-query -W -f='${db:Status-Abbrev} ${Package}\n' 'nvidia-driver-pinning-*' 2>/dev/null \
        | awk '$1 == "ii" { print $2 }' || true
}

sb_state() { # enabled | disabled | unknown
    if [ -n "${TAOS_GPU_SB_STATE:-}" ]; then echo "$TAOS_GPU_SB_STATE"; return 0; fi
    if [ ! -d "$SYSFS_ROOT/firmware/efi" ]; then echo disabled; return 0; fi
    if command -v mokutil >/dev/null 2>&1; then
        o=$(mokutil --sb-state 2>&1) || true
        case $o in
            *"SecureBoot enabled"*) echo enabled; return 0 ;;
            *"SecureBoot disabled"*) echo disabled; return 0 ;;
        esac
    fi
    echo unknown
}

DKMS_KEY=${TAOS_GPU_DKMS_KEY:-/var/lib/dkms/mok.pub}

# Set MOKST: not_required | missing | enrolled | pending | not_enrolled | unknown.
# mokutil --test-key exits 0 and prints "is not enrolled" when the key can be
# imported; otherwise it says why not ("already enrolled", "already in the
# enrollment request" for a pending import).
mok_state() {
    MOKST=""
    if [ -n "${TAOS_GPU_MOK_STATE:-}" ]; then MOKST=$TAOS_GPU_MOK_STATE; return 0; fi
    if [ ! -f "$DKMS_KEY" ]; then MOKST=missing; return 0; fi
    if ! command -v mokutil >/dev/null 2>&1; then MOKST=unknown; return 0; fi
    o=$(mokutil --test-key "$DKMS_KEY" 2>&1) || true
    case $o in
        *"is not enrolled"*) MOKST=not_enrolled ;;
        *"already in the enrollment request"*) MOKST=pending ;;
        *"already enrolled"*|*"already in db"*) MOKST=enrolled ;;
        *) MOKST=unknown ;;
    esac
}

sources_dir() { echo "$ETC_ROOT/apt/sources.list.d"; }

repo_configured() {
    d=$(sources_dir)
    [ -e "$d/$NV_LIST_DEB" ] || [ -e "$d/$NV_LIST_TAOS" ]
}

sha256_of() { sha256sum "$1" | cut -d' ' -f1; }

jstr() { if [ -n "$1" ]; then printf '"%s"' "$1"; else printf 'null'; fi; }

vendor_present() { # vendor name -> 0 if any GPU of it
    while IFS='|' read -r pci ven drv kind boot conn; do
        [ "$ven" = "$1" ] && return 0
    done <<EOF
$GPUS
EOF
    return 1
}

vendor_gpus() { # vendor -> comma list of PCI addresses
    out=""
    while IFS='|' read -r pci ven drv kind boot conn; do
        [ "$ven" = "$1" ] && out="${out:+$out,}$pci"
    done <<EOF
$GPUS
EOF
    echo "$out"
}

vendor_drivers() { # vendor -> comma list of distinct bound drivers
    out=""
    while IFS='|' read -r pci ven drv kind boot conn; do
        [ "$ven" = "$1" ] || continue
        case ",$out," in *",$drv,"*) ;; *) out="${out:+$out,}$drv" ;; esac
    done <<EOF
$GPUS
EOF
    echo "$out"
}

vendors_present() { # distinct vendors in scan order, comma list
    out=""
    while IFS='|' read -r pci ven drv kind boot conn; do
        [ -n "$pci" ] || continue
        case ",$out," in *",$ven,"*) ;; *) out="${out:+$out,}$ven" ;; esac
    done <<EOF
$GPUS
EOF
    echo "$out"
}

driver_usage() {
    cat <<USAGE
Usage: taos-gpu driver <command>
  status [--json]                      vendor drivers, choice, NVIDIA repo and Secure Boot state
  install nvidia [--branch N] [--kernel open|closed] [--dry-run] [--force]
                                       official NVIDIA driver from NVIDIA's apt repo (amd64)
  install cuda [--version 13-5] [--dry-run]   CUDA toolkit (not part of the default install)
  install amd | intel [--dry-run]      GPU firmware (the in-kernel driver with Mesa is official)
  remove nvidia [--dry-run]            purge the NVIDIA packages and the repo, back to open source
  set nvidia open                      record the open-source choice without touching packages
USAGE
}

cmd_driver_status() {
    json=0
    [ "${1:-}" = "--json" ] && json=1
    scan
    resolve
    sb=$(sb_state)
    if [ "$sb" = enabled ]; then
        mok_state
    else
        MOKST=not_required
    fi
    nvdrv=$(conf_get NVIDIA_DRIVER)
    nvker=$(conf_get NVIDIA_KERNEL)
    nvbr=$(conf_get NVIDIA_BRANCH)
    nvver=$(pkg_version nvidia-driver-cuda)
    repo=false
    if repo_configured; then repo=true; fi
    vlist=$(vendors_present)
    if [ "$json" -eq 1 ]; then
        printf '{"vendors": ['
        sep=""
        for v in $(echo "$vlist" | tr ',' ' '); do
            printf '%s{"vendor": "%s", "gpus": %s, "bound_drivers": %s, ' \
                "$sep" "$v" "$(json_arr "$(vendor_gpus "$v")")" "$(json_arr "$(vendor_drivers "$v")")"
            case $v in
                NVIDIA)
                    inst=false
                    if [ -n "$nvver" ]; then inst=true; fi
                    printf '"choice": %s, "official": {"installed": %s, "package": "nvidia-driver-cuda", "version": %s, "repo_configured": %s, "kernel": %s, "branch": %s, "secure_boot": "%s", "dkms_key": "%s"}}' \
                        "$(jstr "$nvdrv")" "$inst" "$(jstr "$nvver")" "$repo" "$(jstr "$nvker")" "$(jstr "$nvbr")" "$sb" "$MOKST"
                    ;;
                AMD|Intel)
                    if [ "$v" = AMD ]; then fw=firmware-amd-graphics; kd=amdgpu; else fw=firmware-intel-graphics; kd="i915 or xe"; fi
                    fi_=false
                    if pkg_installed "$fw"; then fi_=true; fi
                    printf '"choice": null, "official": {"kind": "in-kernel", "driver": "%s", "userspace": "Mesa", "firmware_package": "%s", "firmware_installed": %s}}' \
                        "$kd" "$fw" "$fi_"
                    ;;
                *) printf '"choice": null, "official": null}' ;;
            esac
            sep=", "
        done
        printf ']}\n'
        return 0
    fi
    if [ -z "$vlist" ]; then echo "no GPU found"; return 0; fi
    for v in $(echo "$vlist" | tr ',' ' '); do
        n=$(vendor_gpus "$v" | tr ',' '\n' | wc -l | tr -d ' ')
        echo "$v: $n GPU(s), bound driver: $(vendor_drivers "$v" | tr ',' ' ')"
        case $v in
            NVIDIA)
                echo "  choice: ${nvdrv:-unset} (official is installed by default, open is the opt-out)"
                if [ -n "$nvver" ]; then
                    echo "  official driver: installed, nvidia-driver-cuda $nvver${nvker:+, $nvker kernel modules}${nvbr:+, branch $nvbr}"
                else
                    echo "  official driver: not installed (taos-gpu driver install nvidia)"
                fi
                if [ "$repo" = true ]; then echo "  NVIDIA apt repo: configured"; else echo "  NVIDIA apt repo: not configured"; fi
                echo "  Secure Boot: $sb"
                case $MOKST in
                    not_required) echo "  DKMS signing key: enrollment not required" ;;
                    missing) echo "  DKMS signing key: not generated yet (created by the first driver build)" ;;
                    enrolled) echo "  DKMS signing key: enrolled" ;;
                    pending) echo "  DKMS signing key: enrollment pending, finish it in the blue MOK screen on next boot" ;;
                    not_enrolled) echo "  DKMS signing key: not enrolled (taos-gpu driver install nvidia imports it)" ;;
                    *) echo "  DKMS signing key: enrollment state unknown" ;;
                esac
                ;;
            AMD|Intel)
                if [ "$v" = AMD ]; then fw=firmware-amd-graphics; kd=amdgpu; else fw=firmware-intel-graphics; kd="i915 or xe"; fi
                echo "  official driver: the in-kernel $kd driver with Mesa, nothing to install"
                if pkg_installed "$fw"; then echo "  $fw: installed"; else echo "  $fw: not installed (taos-gpu driver install $(echo "$v" | tr 'A-Z' 'a-z'))"; fi
                ;;
            *) echo "  official driver: not managed by taos-gpu" ;;
        esac
    done
}

# Rewrite KEY=VALUE in gpu.conf in place (append when new, drop when VALUE is empty).
conf_set() {
    found=0
    out=""
    if [ -r "$CONF" ]; then
        while IFS= read -r line || [ -n "$line" ]; do
            case $line in
                "$1="*)
                    if [ -n "$2" ] && [ "$found" -eq 0 ]; then out="$out$1=$2$nl"; found=1; fi
                    ;;
                *) out="$out$line$nl" ;;
            esac
        done < "$CONF"
    fi
    if [ "$found" -eq 0 ] && [ -n "$2" ]; then out="$out$1=$2$nl"; fi
    printf '%s' "$out" | write_atomic "$CONF"
}

conf_get() { # key -> value (empty when unset)
    if [ -r "$CONF" ]; then
        sed -n "s/^$1=//p" "$CONF" | tail -n 1
    fi
}

record_choice() { # driver kernel branch
    if [ "$DRY" -eq 1 ]; then
        plan "write to $CONF: NVIDIA_DRIVER=$1 NVIDIA_KERNEL=${2:-} NVIDIA_BRANCH=${3:-} (DISPLAY_GPU kept)"
        run taos-gpu apply
        return 0
    fi
    conf_set NVIDIA_DRIVER "$1"
    conf_set NVIDIA_KERNEL "${2:-}"
    conf_set NVIDIA_BRANCH "${3:-}"
    cmd_apply
}

# Download the keyring deb, check its SHA256, install it. Idempotent: skipped
# when the NVIDIA sources file already exists.
configure_repo() {
    if repo_configured; then
        say "NVIDIA apt repo already configured, skipping keyring download"
        run apt-get update
        return 0
    fi
    want=${TAOS_GPU_KEYRING_SHA256:-$NV_KEYRING_SHA256}
    if [ "$DRY" -eq 1 ]; then TMPD=/tmp/taos-nvidia.XXXXXX; else TMPD=$(mktemp -d); trap cleanup_tmp EXIT; fi
    kf=$TMPD/$NV_KEYRING_DEB
    if [ -n "${TAOS_GPU_KEYRING_FILE:-}" ]; then
        kf=$TAOS_GPU_KEYRING_FILE
    else
        if [ "$DRY" -eq 1 ]; then
            plan "only if curl is missing:"
            show_cmd apt-get install -y --no-install-recommends ca-certificates curl
        elif ! command -v curl >/dev/null 2>&1; then
            run apt-get update
            run apt-get install -y --no-install-recommends ca-certificates curl
        fi
        run curl -fsSL -o "$kf" "$NV_BASE/$NV_KEYRING_DEB"
    fi
    if [ -f "$kf" ]; then
        got=$(sha256_of "$kf")
        if [ "$got" != "$want" ]; then
            die "keyring checksum mismatch: expected $want but got $got ($kf); refusing to install it" 1
        fi
        plan "sha256 of $kf verified: $want"
    else
        echo "+ echo '$want  $kf' | sha256sum -c -"
    fi
    run dpkg -i "$kf"
    if [ "$DRY" -eq 1 ]; then
        plan "sources: cuda-keyring ships /etc/apt/sources.list.d/$NV_LIST_DEB (signed-by=$NV_KEYRING_GPG); no duplicate $NV_LIST_TAOS is written"
    elif ! repo_configured; then
        say "keyring package shipped no sources file, writing $NV_LIST_TAOS"
        mkdir -p "$(sources_dir)"
        printf 'deb [signed-by=%s] %s/ /\n' "$NV_KEYRING_GPG" "$NV_BASE" > "$(sources_dir)/$NV_LIST_TAOS"
    fi
    run apt-get update
}

box() {
    echo "+------------------------------------------------------------------+"
    for l in "$@"; do printf '| %-64s |\n' "$l"; done
    echo "+------------------------------------------------------------------+"
}

# Secure Boot: the DKMS modules are signed with a key that must be enrolled
# once through the blue MOK Manager screen on the next boot.
secure_boot_enroll() {
    sb=$(sb_state)
    case $sb in
        disabled) say "Secure Boot is off, no key enrollment needed"; return 0 ;;
        enabled) ;;
        *)
            say "could not tell if Secure Boot is on; if it is, run: mokutil --import $DKMS_KEY"
            return 0
            ;;
    esac
    mok_state
    if [ "$MOKST" = missing ]; then
        run dkms generate_mok
        if [ "$DRY" -eq 1 ]; then
            MOKST=not_enrolled
        else
            mok_state
        fi
    fi
    case $MOKST in
        enrolled) say "DKMS signing key already enrolled"; return 0 ;;
        pending) say "DKMS signing key enrollment already pending; finish it in the blue MOK screen on next boot"; return 0 ;;
        not_enrolled) ;;
        missing) say "warning: no DKMS signing key at $DKMS_KEY, modules will not load under Secure Boot until one is enrolled" >&2; return 0 ;;
        *) say "could not check the DKMS key state; if Secure Boot blocks the driver run: mokutil --import $DKMS_KEY" >&2; return 0 ;;
    esac
    pwfile=$ETC_ROOT/taos/mok-enroll-password
    if [ "$DRY" -eq 1 ]; then
        pw="<password>"
        plan "umask 077; hash file in a private temp dir"
        echo "+ mokutil --generate-hash=<password> > <hashfile>"
        show_cmd mokutil --import "$DKMS_KEY" --hash-file "<hashfile>"
        plan "write the one-time password to $pwfile (mode 0600)"
    else
        pw=$(tr -dc 'a-z0-9' < /dev/urandom | head -c 8) || true
        [ "${#pw}" -eq 8 ] || die "could not generate a one-time password" 1
        oldmask=$(umask)
        umask 077
        hd=$(mktemp -d)
        mokutil --generate-hash="$pw" > "$hd/hash"
        mokutil --import "$DKMS_KEY" --hash-file "$hd/hash"
        rm -rf "$hd"
        mkdir -p "$(dirname "$pwfile")"
        printf '%s\n' "$pw" > "$pwfile"
        chmod 600 "$pwfile"
        umask "$oldmask"
    fi
    box "SECURE BOOT: one step is needed on the next reboot." \
        "" \
        "1. Reboot. A blue screen 'Perform MOK management' appears." \
        "2. Choose: Enroll MOK -> Continue -> Yes" \
        "3. Type this one-time password: $pw" \
        "4. Choose Reboot." \
        "" \
        "Skip it and the NVIDIA driver will not load."
    echo "The password is also saved in $pwfile"
}

nvidia_display_profile() { # 0 when the full display stack is needed
    if [ -n "$DISP" ]; then
        [ "$(vendor_of "$DISP")" = NVIDIA ]
        return
    fi
    # No usable display GPU: full stack only on an NVIDIA-only machine.
    while IFS='|' read -r pci ven drv kind boot conn; do
        [ -n "$pci" ] || continue
        [ "$ven" = NVIDIA ] || return 1
    done <<EOF
$GPUS
EOF
    return 0
}

cmd_driver_install_nvidia() {
    branch=""
    kernel=open
    force=0
    while [ $# -gt 0 ]; do
        case $1 in
            --branch)
                [ $# -ge 2 ] || die "--branch needs a driver branch number, e.g. 620" 2
                branch=$2
                case $branch in ''|*[!0-9]*) die "--branch must be a number like 620" 2 ;; esac
                shift 2
                ;;
            --kernel)
                [ $# -ge 2 ] || die "--kernel needs open or closed" 2
                kernel=$2
                case $kernel in open|closed) ;; *) die "--kernel must be open or closed" 2 ;; esac
                shift 2
                ;;
            --dry-run) DRY=1; shift ;;
            --force) force=1; shift ;;
            *) die "unknown option '$1' (see 'taos-gpu driver')" 2 ;;
        esac
    done
    [ "$DRY" -eq 1 ] || need_root
    arch=$(host_arch)
    if [ "$arch" != amd64 ]; then
        die "the official NVIDIA driver repo is amd64 only (this machine is $arch); nothing was changed" 1
    fi
    osr="$ETC_ROOT/os-release"
    if [ -r "$osr" ] && [ "$force" -eq 0 ]; then
        if ! grep -q '^ID=debian$' "$osr" || ! grep -q '^VERSION_ID="\{0,1\}13"\{0,1\}$' "$osr"; then
            die "the NVIDIA repo used here is for Debian 13; this is not Debian 13 (use --force to try anyway)" 1
        fi
    fi
    scan
    resolve
    if ! vendor_present NVIDIA && [ "$force" -eq 0 ]; then
        die "no NVIDIA GPU found, nothing to install (use --force to install anyway)" 1
    fi
    if nvidia_display_profile; then profile=full; else profile=compute; fi
    if [ "$kernel" = closed ] && { [ -z "$branch" ] || [ "$branch" -ge 615 ]; }; then
        say "note: driver branches from 615 only ship the open kernel modules; nvidia-kernel-dkms there is just an alias for the open ones. Older cards that need closed modules need --branch below 615." >&2
    fi
    export DEBIAN_FRONTEND=noninteractive
    say "NVIDIA official driver, $profile profile, $kernel kernel modules${branch:+, branch $branch}"
    [ "$DRY" -eq 1 ] && say "dry run: nothing is executed, the plan follows"

    configure_repo

    if [ -n "$branch" ]; then
        want_pin=nvidia-driver-pinning-$branch
        for p in $(installed_pinning); do
            [ "$p" = "$want_pin" ] || run apt-get remove -y "$p"
        done
        run apt-get install -y "$want_pin"
    fi

    hdr=linux-headers-$arch
    if [ "$kernel" = closed ]; then
        run apt-get install -y "$hdr" dkms mokutil build-essential
    else
        run apt-get install -y "$hdr" dkms mokutil
    fi

    if [ "$profile" = compute ]; then
        if [ "$kernel" = closed ]; then kpkg=nvidia-kernel-dkms; else kpkg=nvidia-kernel-open-dkms; fi
        # Compute only: no X server, no display stack. Checked against the repo
        # Packages file: nvidia-driver-cuda has no Recommends and its Depends
        # closure holds no xserver; --no-install-recommends drops the
        # "nvidia-driver | nvidia-driver-cuda" recommendation of the dkms pkg.
        run apt-get install -y --no-install-recommends "$kpkg" nvidia-driver-cuda
    elif [ "$kernel" = closed ]; then
        run apt-get install -y nvidia-driver nvidia-kernel-dkms
    else
        run apt-get install -y nvidia-open
    fi

    record_choice official "$kernel" "$branch"
    secure_boot_enroll
    say "NVIDIA official driver ($profile profile, $kernel modules) set up; reboot required"
}

cmd_driver_install_cuda() {
    ver=""
    while [ $# -gt 0 ]; do
        case $1 in
            --version)
                [ $# -ge 2 ] || die "--version needs a CUDA version like 13-5" 2
                ver=$2
                case $ver in [0-9]*-[0-9]*) ;; *) die "--version must look like 13-5" 2 ;; esac
                shift 2
                ;;
            --dry-run) DRY=1; shift ;;
            *) die "unknown option '$1' (see 'taos-gpu driver')" 2 ;;
        esac
    done
    [ "$DRY" -eq 1 ] || need_root
    arch=$(host_arch)
    if [ "$arch" != amd64 ]; then
        die "the CUDA repo used here is amd64 only (this machine is $arch); nothing was changed" 1
    fi
    export DEBIAN_FRONTEND=noninteractive
    configure_repo
    run apt-get install -y "cuda-toolkit${ver:+-$ver}"
    say "CUDA toolkit installed (optional, not part of the default install)"
}

cmd_driver_install_fw() { # amd|intel
    case $1 in
        amd) fw=firmware-amd-graphics; kd=amdgpu ;;
        *) fw=firmware-intel-graphics; kd="i915 or xe" ;;
    esac
    shift
    while [ $# -gt 0 ]; do
        case $1 in
            --dry-run) DRY=1; shift ;;
            *) die "unknown option '$1' (see 'taos-gpu driver')" 2 ;;
        esac
    done
    [ "$DRY" -eq 1 ] || need_root
    export DEBIAN_FRONTEND=noninteractive
    run apt-get install -y "$fw"
    say "the official driver for these GPUs is the in-kernel $kd driver with Mesa; $fw only adds firmware (needs the non-free-firmware apt component)"
    say "compute stacks (ROCm, Intel compute runtime) are not handled yet"
}

cmd_driver_remove_nvidia() {
    while [ $# -gt 0 ]; do
        case $1 in
            --dry-run) DRY=1; shift ;;
            *) die "unknown option '$1' (see 'taos-gpu driver')" 2 ;;
        esac
    done
    [ "$DRY" -eq 1 ] || need_root
    export DEBIAN_FRONTEND=noninteractive
    pats="nvidia-* libnvidia-* cuda-* libcuda* libnvcuvid* libnvoptix* libcudadebugger* xserver-xorg-video-nvidia* firmware-nvidia-gsp"
    if [ "$DRY" -eq 1 ]; then
        plan "purges every installed package matching: $pats"
        # shellcheck disable=SC2086
        show_cmd apt-get purge -y $pats
    else
        # dpkg-query globs list only installed matches, so apt never sees a
        # pattern that matches nothing.
        # shellcheck disable=SC2086
        inst=$(dpkg-query -W -f='${db:Status-Abbrev} ${Package}\n' $pats 2>/dev/null | awk '$1 == "ii" { print $2 }') || true
        if [ -n "$inst" ]; then
            # shellcheck disable=SC2086
            run apt-get purge -y $inst
        else
            say "no NVIDIA packages installed"
        fi
    fi
    run apt-get autoremove -y --purge
    if [ "$DRY" -eq 1 ]; then
        show_cmd rm -f "$(sources_dir)/$NV_LIST_TAOS"
    else
        rm -f "$(sources_dir)/$NV_LIST_TAOS"
    fi
    record_choice open "" ""
    say "NVIDIA packages and repo removed, open-source driver selected; reboot required"
}

cmd_driver_set() {
    [ "$#" -eq 2 ] && [ "$1" = nvidia ] && [ "$2" = open ] || die "usage: taos-gpu driver set nvidia open" 2
    need_root
    conf_set NVIDIA_DRIVER open
    conf_set NVIDIA_KERNEL ""
    conf_set NVIDIA_BRANCH ""
    cmd_apply
}

cmd_driver() {
    dry_init
    sub=${1:-}
    [ $# -gt 0 ] && shift
    case $sub in
        status) cmd_driver_status "$@" ;;
        install)
            what=${1:-}
            [ $# -gt 0 ] && shift
            case $what in
                nvidia) cmd_driver_install_nvidia "$@" ;;
                cuda) cmd_driver_install_cuda "$@" ;;
                amd|intel) cmd_driver_install_fw "$what" "$@" ;;
                *) driver_usage >&2; exit 2 ;;
            esac
            ;;
        remove)
            [ "${1:-}" = nvidia ] || { driver_usage >&2; exit 2; }
            shift
            cmd_driver_remove_nvidia "$@"
            ;;
        set) cmd_driver_set "$@" ;;
        --help|-h|help) driver_usage ;;
        *) driver_usage >&2; exit 2 ;;
    esac
}

cmd=${1:-}
[ $# -gt 0 ] && shift
case "$cmd" in
    list) cmd_list "$@" ;;
    status) cmd_status "$@" ;;
    set-display) cmd_set_display "$@" ;;
    apply) cmd_apply ;;
    driver) cmd_driver "$@" ;;
    --help|-h|help) usage ;;
    *) usage >&2; exit 2 ;;
esac
