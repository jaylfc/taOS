# Renders the title bar with the buttons on each side and checks the pictures are there and the two sides differ.
file(MAKE_DIRECTORY ${OUT})
set(ENV{QT_QPA_PLATFORM} offscreen)
set(ENV{TAOS_THEME_VARIANT} dark)
foreach(side left right)
  file(WRITE ${OUT}/${side}.json "{\"theme\": \"graphite\", \"mode\": \"dark\", \"windowButtons\": \"${side}\"}\n")
  set(ENV{TAOS_APPEARANCE} ${OUT}/${side}.json)
  execute_process(COMMAND ${BIN} ${OUT} RESULT_VARIABLE rc ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "render (${side}) failed: ${rc} ${err}")
  endif()
endforeach()
foreach(state normal group-hover close-hover focus)
  foreach(side left right)
    set(f ${OUT}/titlebar-${side}-dark-${state}.png)
    if(NOT EXISTS ${f})
      message(FATAL_ERROR "missing ${f}")
    endif()
    file(SIZE ${f} sz)
    if(sz LESS 600)
      message(FATAL_ERROR "${f} is empty")
    endif()
  endforeach()
  file(SHA256 ${OUT}/titlebar-left-dark-${state}.png a)
  file(SHA256 ${OUT}/titlebar-right-dark-${state}.png b)
  if(a STREQUAL b)
    message(FATAL_ERROR "left and right look the same in state ${state}")
  endif()
endforeach()
# hover and focus must look different from the plain state
file(SHA256 ${OUT}/titlebar-left-dark-normal.png n)
foreach(state group-hover close-hover focus)
  file(SHA256 ${OUT}/titlebar-left-dark-${state}.png h)
  if(n STREQUAL h)
    message(FATAL_ERROR "state ${state} looks like the normal state")
  endif()
endforeach()
