file(READ ${DESKTOP} all)
function(expect line)
  string(FIND "${all}" "\n${line}\n" idx)
  if(idx LESS 0)
    message(FATAL_ERROR "generated .desktop lacks the line: ${line}\n${all}")
  endif()
endfunction()
expect("Name=Dummy App")
expect("Exec=taos-dummy %U")
expect("Icon=my.taos.dummy")
expect("StartupWMClass=my.taos.dummy")
expect("Categories=Utility;")
expect("X-taOS-AppId=my.taos.dummy")
if(all MATCHES "@[A-Z_]+@")
  message(FATAL_ERROR "unreplaced placeholder in the .desktop file")
endif()
find_program(VALIDATOR desktop-file-validate)
if(VALIDATOR)
  execute_process(COMMAND ${VALIDATOR} ${DESKTOP} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE out)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "desktop-file-validate: ${out}")
  endif()
endif()
