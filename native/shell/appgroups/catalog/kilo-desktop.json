    "url": "https://kilo.ai/terms"
  },
  "icon": {"glyph": "code"},
  "categories": ["Development", "IDE"],
  "arch": ["amd64"],
  "recipe": [
    {"op": "download-deb", "package": "kilo-desktop", "url": "https://autoupdate.desktop.anaconda.com/kilo-desktop/latest/linux/x64/kilo-desktop_1.0.0_amd64.deb", "sha256": "5d9d8b00ac958cba8722bce54eefc502a6fa092a5dad27cf34984800ed388b81"}
