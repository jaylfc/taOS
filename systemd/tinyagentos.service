[Unit]
Description=TinyAgentOS Controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/tinyagentos
ExecStart=%h/tinyagentos/.venv/bin/python -m uvicorn tinyagentos.app:create_app --factory --host 0.0.0.0 --port 6969
ExecStop=/usr/local/bin/taos-graceful-stop
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
# Private scratch dir for taos-graceful-stop's dedupe stamp (see the same block
# in scripts/systemd/tinyagentos.service): without it the stamp lands in
# world-writable /tmp, where any local user can suppress the agent drain.
RuntimeDirectory=taos
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
